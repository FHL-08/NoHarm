{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "log/1"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "version": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "change": {
            "type": "string",
            "pattern": "^C-[0-9]{3,}$"
          },
          "change_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "receipt_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "from_hash": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "to_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "version",
          "change",
          "change_sha256",
          "receipt_sha256",
          "from_hash",
          "to_hash"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema",
    "entries"
  ],
  "additionalProperties": false
}
