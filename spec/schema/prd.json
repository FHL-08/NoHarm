{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "prd/1"
    },
    "project": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "header": {
      "type": "object",
      "properties": {
        "problem": {
          "type": "string",
          "minLength": 1
        },
        "users": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "who": {
                "type": "string",
                "minLength": 1
              },
              "need": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "who",
              "need"
            ],
            "additionalProperties": false
          }
        },
        "goals": {
          "minItems": 1,
          "maxItems": 3,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^G-[1-9]$"
              },
              "purpose": {
                "type": "string",
                "minLength": 1
              },
              "advantage": {
                "type": "string",
                "minLength": 1
              },
              "measure": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "purpose",
              "advantage",
              "measure"
            ],
            "additionalProperties": false
          }
        },
        "principles": {
          "minItems": 3,
          "maxItems": 7,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "non_goals": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "glossary": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "term": {
                "type": "string",
                "minLength": 1
              },
              "means": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "term",
              "means"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "problem",
        "users",
        "goals",
        "principles",
        "non_goals",
        "owner",
        "glossary"
      ],
      "additionalProperties": false
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^K-[1-9][0-9]*$"
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "why": {
            "type": "string",
            "minLength": 1
          },
          "check": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "text",
          "why"
        ],
        "additionalProperties": false
      }
    },
    "stack": {
      "type": "object",
      "properties": {
        "decided": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "role": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "name",
              "role"
            ],
            "additionalProperties": false
          }
        },
        "proposed": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "role": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "name",
              "role"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "decided",
        "proposed"
      ],
      "additionalProperties": false
    },
    "verticals": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]{1,23}$"
      }
    },
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "id",
          "path",
          "sha256"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema",
    "project",
    "version",
    "header",
    "constraints",
    "stack",
    "verticals",
    "references"
  ],
  "additionalProperties": false
}
