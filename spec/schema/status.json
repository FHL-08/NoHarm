{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "status/1"
    },
    "lines": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9]{1,7}-[1-9][0-9]*\\.[1-9][0-9]*$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "v": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "state": {
            "type": "string",
            "enum": [
              "unknown",
              "pass",
              "fail"
            ]
          },
          "at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "v",
          "state",
          "at",
          "evidence"
        ],
        "additionalProperties": false
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "question": {
            "type": "string",
            "minLength": 1
          },
          "blocks": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9]{1,7}-[1-9][0-9]*$"
            }
          }
        },
        "required": [
          "id",
          "question",
          "blocks"
        ],
        "additionalProperties": false
      }
    },
    "waiting_room": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "idea": {
            "type": "string",
            "minLength": 1
          },
          "from": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "idea",
          "from"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema",
    "lines",
    "open_questions",
    "waiting_room"
  ],
  "additionalProperties": false
}
