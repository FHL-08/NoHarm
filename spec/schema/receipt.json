{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "receipt/1"
    },
    "change": {
      "type": "string",
      "pattern": "^C-[0-9]{3,}$"
    },
    "change_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "role": {
      "type": "string",
      "enum": [
        "lead",
        "reviewer"
      ]
    },
    "approver": {
      "type": "string",
      "minLength": 1
    },
    "via": {
      "type": "string",
      "enum": [
        "terminal",
        "whatsapp",
        "console"
      ]
    },
    "at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    }
  },
  "required": [
    "schema",
    "change",
    "change_sha256",
    "role",
    "approver",
    "via",
    "at"
  ],
  "additionalProperties": false
}
